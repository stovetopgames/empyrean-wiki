---
// The game's own region map with one hotspot per 16x16 town-map square.
// Squares belonging to the same place share a data-place value, so hovering any
// one of them highlights the whole route or town the way the in-game map does.
// Hotspots are positioned in percentages so the whole overlay scales with the
// image on narrow screens without any layout maths at runtime.
import type { Region } from '../lib/game';

interface Props { region: Region; scale?: number; highlight?: string | null }
const { region, scale = 2, highlight = null } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const pctX = (v: number) => (v / region.width) * 100;
const pctY = (v: number) => (v / region.height) * 100;
const boxW = pctX(region.square);
const boxH = pctY(region.square);

const keyOf = (name: string, slug: string | null) => `${name.toLowerCase()}|${slug ?? ''}`;
const linkedCount = region.places.filter((p) => p.slug).length;
---

<figure class="regionmap" data-regionmap>
  <div class="mapframe" style={`max-width:${region.width * scale}px`}>
    <img src={`${base}/${region.image}`} alt={`Map of ${region.displayName}`}
         width={region.width * scale} height={region.height * scale} />
    {region.points.map((p) => {
      const key = keyOf(p.name, p.slug);
      const style = `left:${pctX(p.x * region.square)}%; top:${pctY(p.y * region.square)}%;`
        + `width:${boxW}%; height:${boxH}%`;
      return p.slug ? (
        <a
          class:list={['hotspot', 'linked', { current: highlight && p.slug === highlight }]}
          style={style}
          href={`${base}/locations/${p.slug}`}
          data-place={key}
          data-label={p.name}
          title={p.name}
          aria-label={p.name}
        />
      ) : (
        <span class="hotspot" style={style} data-place={key} data-label={p.name}
              title={`${p.name} (no page yet)`} />
      );
    })}
  </div>
  <figcaption>
    <span data-label-out>{region.displayName} &mdash; {region.places.length} places, {linkedCount} with a page</span>
  </figcaption>
</figure>

<style>
  .regionmap { margin: 0; }
  .mapframe {
    position: relative;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 8px;
    overflow: hidden;
    background: var(--sl-color-gray-7);
    line-height: 0;
  }
  .mapframe img {
    image-rendering: pixelated;
    display: block;
    width: 100%;
    height: auto;
  }
  .hotspot {
    position: absolute;
    box-sizing: border-box;
    border-radius: 2px;
  }
  .hotspot.linked { cursor: pointer; }
  .regionmap :global(.hotspot.on) {
    background: rgba(80, 140, 255, .4);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .85);
  }
  .hotspot.current {
    background: rgba(255, 186, 40, .5);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .95);
  }
  figcaption {
    margin-top: .45rem;
    font-size: .82rem;
    color: var(--sl-color-gray-2);
    min-height: 1.3em;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-regionmap]').forEach((fig) => {
    const out = fig.querySelector('[data-label-out]');
    const idle = out?.textContent ?? '';
    const spots = Array.from(fig.querySelectorAll<HTMLElement>('.hotspot'));

    const setActive = (key: string | null) => {
      for (const s of spots) s.classList.toggle('on', !!key && s.dataset.place === key);
    };

    for (const s of spots) {
      const show = () => {
        setActive(s.dataset.place ?? null);
        if (out) {
          out.textContent = s.dataset.label + (s.tagName === 'A' ? '' : ' — no page yet');
        }
      };
      const hide = () => {
        setActive(null);
        if (out) out.textContent = idle;
      };
      s.addEventListener('mouseenter', show);
      s.addEventListener('focus', show);
      s.addEventListener('mouseleave', hide);
      s.addEventListener('blur', hide);
    }
  });
</script>
