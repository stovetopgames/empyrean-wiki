---
interface Props { slug: string; alt: string; shiny?: boolean; size?: number; icon?: boolean }
const { slug, alt, shiny = false, size = 160, icon = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dir = icon ? 'icons' : 'sprites';
const file = icon ? `${slug}.png` : `${slug}${shiny ? '-shiny' : ''}.png`;
---
<img class="game-sprite" src={`${base}/${dir}/${file}`} alt={alt}
     width={size} height={size} loading="lazy" decoding="async" />
<style>
  .game-sprite { image-rendering: pixelated; }
</style>
